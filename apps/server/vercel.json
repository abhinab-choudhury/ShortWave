{
  "version": 2,
  "builds": [
    {
      "src": "dist/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/index.js"
    }
  ],
  "cron": [
    {
      "path": "/dist/cron/sync-analytics.js",
      "schedule": "*/10 * * * *",
      "method": "GET"
    }
  ]
}
