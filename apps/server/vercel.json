{
  "version": 2,
  "builds": [
    {
      "src": "./dist/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "./dist/index.js"
    }
  ],
  "cron": [
    {
      "path": "/cron/flush",
      "schedule": "*/5 * * * *",
      "method": "GET"
    }
  ]
}
