# VITE_SERVER_URL points the client at the shortwave API server (apps/server, default port 8080).
#
# Web (desktop browser / vite dev):
#   http://localhost:8080          <- the server runs on the same machine as the browser
#
# Android emulator build:
#   http://10.0.2.2:8080            <- 10.0.2.2 is the emulator's alias for the host machine's loopback.
#                                      Put this in .env.android (NOT .env) and build with:
#                                      pnpm --filter client run mobile:build
#                                      which runs `vite build --mode android` and loads .env.android
#
# Physical Android device:
#   http://<your-LAN-IP>:8080       <- e.g. http://192.168.1.20:8080, a LAN IP the phone can reach.
#                                      Replace 10.0.2.2 in .env.android with your machine's LAN IP
#                                      (find it with `ip a` / `ifconfig`), open inbound TCP 8080 in
#                                      your firewall, then rebuild via mobile:build.
#
# Copy this file to `.env` for web development.
VITE_SERVER_URL="http://localhost:8080"